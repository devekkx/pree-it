// Grafana Alloy unified collector (River syntax).
// Handles all three signal types for the LGTM stack:
//   Metrics  - scrapes /metrics endpoints - remote-writes to Mimir
//   Traces   - receives OTLP from services - forwards to Tempo
//   Logs     - tails Docker container logs - forwards to Loki

// Metrics

prometheus.scrape "gateway" {
  targets         = [{ "__address__" = "gateway:8080" }]
  forward_to      = [prometheus.remote_write.mimir.receiver]
  scrape_interval = "15s"
  metrics_path    = "/metrics"
}

prometheus.scrape "auth" {
  targets         = [{ "__address__" = "auth:8081" }]
  forward_to      = [prometheus.remote_write.mimir.receiver]
  scrape_interval = "15s"
  metrics_path    = "/metrics"
}

prometheus.scrape "nats" {
  targets         = [{ "__address__" = "nats:8222" }]
  forward_to      = [prometheus.remote_write.mimir.receiver]
  scrape_interval = "15s"
  metrics_path    = "/metrics"
}

prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir:9009/api/v1/push"
  }
}

// Traces

otelcol.receiver.otlp "default" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }

  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls { insecure = true }
  }
}

// Logs

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.containers.targets
  forward_to = [loki.write.default.receiver]

  labels = {
    "job" = "docker",
    "env" = "development",
  }
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}