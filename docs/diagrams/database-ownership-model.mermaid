flowchart TB

    POSTGRES["PostgreSQL Cluster"]

    AUTHDB["auth_schema"]
    USERDB["user_schema"]
    CHATDB["chat_schema"]
    MEDIADB["media_schema"]

    POSTGRES --> AUTHDB
    POSTGRES --> USERDB
    POSTGRES --> CHATDB
    POSTGRES --> MEDIADB

    AUTH["Auth Service"] --> AUTHDB
    USER["User Service"] --> USERDB
    CHAT["Chat Service"] --> CHATDB
    MEDIA["Media Service"] --> MEDIADB